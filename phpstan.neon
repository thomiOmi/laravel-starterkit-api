includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - public
        - routes
        - modules
        - tests

    # Level 9 is the highest level
    level: max

    tmpDir: storage/framework/cache/phpstan

    excludePaths:
        - config/database.php

    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        -
            message: '#Call to an undefined method Pest\\PendingCalls\\TestCall::#'
        -
            message: '#Access to an undefined property Pest\\PendingCalls\\TestCall::#'
        -
            message: '#Cannot call method .* on mixed.#'
            path: tests/*
        -
            message: '#Cannot call method .* on mixed.#'
            path: modules/*/Tests/*
        -
            message: '#Call to an undefined method Mockery\\ExpectationInterface\|Mockery\\HigherOrderMessage::andReturn\(\).#'
        -
            message: '#Call to method .* of internal class Pest\\Mixins\\Expectation.* from outside its root namespace Pest.#'
        -
            message: '#Call to method .* of internal class Pest\\Expectation from outside its root namespace Pest.#'
        -
            message: '#Cannot access property \$not on mixed.#'
            path: tests/Feature/ArchitectureTest.php
        -
            message: '#Call to method in\(\) of internal class Pest\\PendingCalls\\UsesCall from outside its root namespace Pest.#'
            path: tests/Pest.php
        -
            message: '#Parameter \#. .* of function .* expects string, bool\|string given.#'
            path: config/*.php
