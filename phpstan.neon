includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - public
        - routes
        - modules

    # Level 9 is the highest level
    level: max

    tmpDir: storage/framework/cache/phpstan

    excludePaths:
        - config/database.php

