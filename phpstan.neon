includes:
	- phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
        - modules

    excludePaths:
        - modules/*/Tests/*

    level: max

    tmpDir: storage/framework/cache/phpstan
    parallel:
        maximumNumberOfProcesses: 4
        minimumNumberOfJobsPerProcess: 4
        jobSize: 20

    phpVersion: 80400
