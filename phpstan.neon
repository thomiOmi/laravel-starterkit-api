includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
        - modules
        - tests

    excludePaths:

    level: max

    checkConfigTypes: true
    # Larastan optional rules
    checkModelProperties: true
    checkModelMethodVisibility: true
    noUnnecessaryEnumerableToArrayCalls: true
    generalizeEnvReturnType: true
    checkMissingTranslations: true
    parseModelCastsMethod: true
    checkAuthCallsWhenInRequestScope: true

    # Module migration paths for schema inference
    databaseMigrationsPath:
        - database/migrations
        - modules/*/database/migrations

    # Config dirs for config() type inference (literal, not globbed)
    configDirectories:
        - config
        - modules/IAM/config

    # Translation files (Laravel 13 uses lang/, not resources/lang/)
    # Note: larastan does NOT glob-expand these paths; list module lang dirs literally
    translationDirectories:
        - lang
        - modules/IAM/lang

    # Cache parsed migrations between runs
    enableMigrationCache: true

    parallel:
        maximumNumberOfProcesses: 4
        minimumNumberOfJobsPerProcess: 4
        jobSize: 20

    phpVersion: 80400
