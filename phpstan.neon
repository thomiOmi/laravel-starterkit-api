includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
        - modules

    excludePaths:
        - tests
        - modules/*/Tests/*

    level: max

    tmpDir: storage/framework/cache/phpstan
    parallel:
        maximumNumberOfProcesses: 4
        minimumNumberOfJobsPerProcess: 4
        jobSize: 20

    phpVersion: 80400
