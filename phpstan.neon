includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - public
        - routes
        - modules

    excludePaths:
        - config
        - tests
        - modules/*/Tests/*

    level: max

    tmpDir: storage/framework/cache/phpstan
    parallel:
        maximumNumberOfProcesses: 4
        minimumNumberOfJobsPerProcess: 4
        jobSize: 20

    phpVersion: 80400

    checkModelProperties: true
    checkOctaneCompatibility: false  # flip to true if using Octane

    noEnvCallsOutsideOfConfig: true  # enforces env() only inside config files

    # Catch uninitialized class properties (common in Laravel models & DTOs)
    checkUninitializedProperties: false

    # Treat PHPDoc @var / @param types as certain (strict mode)
    treatPhpDocTypesAsCertain: true

    # Infer property types from constructor assignments (reduces @var noise)
    inferPrivatePropertyTypeFromConstructor: true

    reportUnmatchedIgnoredErrors: true

    ignoreErrors:
        -
            message: '#Return type \(array<string, mixed>\) of method Modules\\User\\Database\\Factories\\UserFactory::definition\(\) should be compatible with return type#'
            path: modules/User/Database/Factories/UserFactory.php
        -
            message: '#Parameter \#1 \$column of method Illuminate\\Database\\Eloquent\\Builder<Illuminate\\Database\\Eloquent\\Model>::where\(\) expects#'
            path: modules/User/Filters/UserFilter.php
