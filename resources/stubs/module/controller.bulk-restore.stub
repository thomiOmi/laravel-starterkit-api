<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Controllers\{{Version}};

use App\Http\Requests\BulkActionRequest;
use Illuminate\Http\JsonResponse;
use Modules\{{Module}}\Actions\BulkRestore{{pluralModule}}Action;
use Symfony\Component\HttpFoundation\Response;

/**
 * @group {{Module}} Management
 *
 * @authenticated
 */
final readonly class BulkRestoreController
{
    public function __construct(
        private BulkRestore{{pluralModule}}Action $bulkRestore{{pluralModule}},
    ) {}

    /**
     * Perform bulk restore on {{lowerResource}}s.
     */
    public function __invoke(BulkActionRequest $request): JsonResponse
    {
        /** @var array{ids: array<int, string|int>} $validated */
        $validated = $request->validated();

        $count = $this->bulkRestore{{pluralModule}}->handle($validated['ids']);

        return new JsonResponse(
            [
                'status' => Response::HTTP_OK,
                'message' => __('general.bulk_action', [
                    'resource' => '{{Module}}s',
                    'action' => 'restore',
                ]),
                'data' => ['count' => $count],
            ],
            Response::HTTP_OK,
        );
    }
}
