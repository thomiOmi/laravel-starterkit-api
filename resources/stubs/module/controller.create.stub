<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Controllers\{{Version}};

use App\Http\Responses\SuccessResponse;
use Modules\{{Module}}\Actions\Create{{Module}}Action;
use Modules\{{Module}}\Requests\{{Version}}\Create{{Module}}Request;
use Modules\{{Module}}\Resources\{{Module}}Resource;
use Symfony\Component\HttpFoundation\Response;

/**
 * @group {{Module}} Management
 *
 * @authenticated
 */
final readonly class CreateController
{
    public function __construct(
        private Create{{Module}}Action $create{{Module}},
    ) {}

    /**
     * Create a newly created {{lowerResource}} in storage.
     */
    public function __invoke(Create{{Module}}Request $request): SuccessResponse
    {
        ${{lowerResource}} = $this->create{{Module}}->handle($request->payload());

        return new SuccessResponse(
            'Created',
            __('general.created', ['resource' => '{{Module}}']),
            new {{Module}}Resource(${{lowerResource}}),
            Response::HTTP_CREATED,
        );
    }
}
