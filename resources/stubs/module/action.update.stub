<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Actions;

use Modules\{{Module}}\Models\{{Module}};
use Modules\{{Module}}\Payloads\{{Version}}\Update{{Module}}Payload;

/**
 * Action for updating an existing {{label}}.
 */
final readonly class Update{{Module}}Action
{
    /**
     * Execute the update {{label}} action.
     *
     * @param  string  $id  The {{label}} ID.
     * @param  Update{{Module}}Payload  $payload  The payload.
     * @return {{Module}} The updated {{label}} instance.
     */
    public function handle(string $id, Update{{Module}}Payload $payload): {{Module}}
    {
        ${{lowerResource}} = {{Module}}::query()->findOrFail($id);

        ${{lowerResource}}->update($payload->toArray());

        return ${{lowerResource}};
    }
}
