<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Controllers\{{Version}};

use App\Http\Responses\ProblemResponse;
use App\Http\Responses\SuccessResponse;
use Modules\{{Module}}\Actions\Delete{{Module}}Action;
use Modules\{{Module}}\Models\{{Module}};
use Symfony\Component\HttpFoundation\Response;

/**
 * @group {{Module}} Management
 *
 * @authenticated
 */
final readonly class DeleteController
{
    public function __construct(
        private Delete{{Module}}Action $delete{{Module}},
    ) {}

    /**
     * Remove the specified {{lowerResource}} from storage.
     *
     * @return SuccessResponse<null>|ProblemResponse
     */
    public function __invoke(string $id): SuccessResponse|ProblemResponse
    {
        if ($this->delete{{Module}}->handle($id)) {
            return new SuccessResponse(null, status: Response::HTTP_NO_CONTENT);
        }

        return new ProblemResponse(
            title: __('http_forbidden'),
            status: Response::HTTP_FORBIDDEN,
            detail: __('general.resource_delete_error', ['resource' => '{{Module}}']),
        );
    }
}
