<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Controllers\{{Version}};

use Illuminate\Http\JsonResponse;
use Modules\{{Module}}\Actions\Delete{{Module}}Action;
use Modules\{{Module}}\Models\{{Module}};
use Symfony\Component\HttpFoundation\Response;

/**
 * @group {{Module}} Management
 *
 * @authenticated
 */
final readonly class DeleteController
{
    public function __construct(
        private Delete{{Module}}Action $delete{{Module}},
    ) {}

    /**
     * Remove the specified {{lowerResource}} from storage.
     */
    public function __invoke({{Module}} ${{lowerResource}}): JsonResponse
    {
        if ($this->delete{{Module}}->handle(${{lowerResource}})) {
            return new JsonResponse(
                [
                    'status' => Response::HTTP_NO_CONTENT,
                    'message' => __('general.deleted', ['resource' => '{{Module}}']),
                    'data' => null,
                ],
                Response::HTTP_NO_CONTENT,
            );
        }

        return new JsonResponse(
            [
                'status' => Response::HTTP_FORBIDDEN,
                'message' => __('general.delete_error', ['resource' => '{{Module}}']),
                'data' => null,
            ],
            Response::HTTP_FORBIDDEN,
        );
    }
}
