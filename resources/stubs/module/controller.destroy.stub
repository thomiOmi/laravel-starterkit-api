<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Controllers\{{Version}};

use App\Http\Controllers\Controller;
use App\Http\Responses\SuccessResponse;
use Modules\{{Module}}\Actions\Delete{{Module}}Action;
use Modules\{{Module}}\Models\{{Module}};
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException;

final readonly class DeleteController extends Controller
{
    public function __construct(
        private Delete{{Module}}Action $delete{{Module}},
    ) {}

    /**
     * Remove the specified {{lowerResource}} from storage.
     *
     * @return SuccessResponse<null>
     */
    public function __invoke(string $id): SuccessResponse
    {
        if ($this->delete{{Module}}->handle($id)) {
            return new SuccessResponse(
                data: null,
                title: __('general.resource_deleted', ['resource' => '{{Module}}']),
                detail: __('general.resource_deleted', ['resource' => '{{Module}}']),
                status: Response::HTTP_OK,
            );
        }

        throw new AccessDeniedHttpException(
            __('general.resource_delete_error', ['resource' => '{{Module}}'])
        );
    }
}
