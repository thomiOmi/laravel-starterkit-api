<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Controllers\{{Version}};

use App\Http\Responses\JsonDataResponse;
use Modules\{{Module}}\Actions\Destroy{{Module}}Action;
use Modules\{{Module}}\Models\{{Module}};
use Symfony\Component\HttpFoundation\Response;

/**
 * @group {{Module}} Management
 *
 * @authenticated
 */
final readonly class DestroyController
{
    public function __construct(
        private Destroy{{Module}}Action $delete{{Module}},
    ) {}

    /**
     * Remove the specified {{lowerResource}} from storage.
     */
    public function __invoke({{Module}} ${{lowerResource}}): JsonDataResponse|Response
    {
        if ($this->delete{{Module}}->handle(${{lowerResource}})) {
            return response()->noContent();
        }

        return new JsonDataResponse(
            data: null,
            status: Response::HTTP_FORBIDDEN,
            message: __('messages.delete_error', ['resource' => '{{Module}}'])
        );
    }
}
