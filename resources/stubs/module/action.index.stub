<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Actions;

use Illuminate\Contracts\Pagination\LengthAwarePaginator;
use Modules\{{Module}}\Filters\{{Module}}Filter;
use Modules\{{Module}}\Models\{{Module}};

/**
 * Action for listing paginated {{labelPlural}} with filters.
 */
final readonly class List{{pluralModule}}Action
{
    /**
     * Execute the list {{labelPlural}} action.
     *
     * @return LengthAwarePaginator<int, {{Module}}>
     */
    public function handle(): LengthAwarePaginator
    {
        return {{Module}}::query()
            ->tap(new {{Module}}Filter(request()))
            ->paginate(
                perPage: max(1, min((int) request()->integer('page.size', 15), 100)),
                page: max(1, (int) request()->integer('page.number', 1)),
            );
    }
}
