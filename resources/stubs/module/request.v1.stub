<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Requests\{{Version}};

use Dedoc\Scramble\Attributes\BodyParameter;
use Illuminate\Contracts\Validation\ValidationRule;
use Illuminate\Foundation\Http\FormRequest;
use Modules\{{Module}}\Payloads\{{Version}}\{{Action}}{{Resource}}Payload;

/**
 * {{Action}} {{Resource}} Request
 */
#[BodyParameter(name: 'name', description: 'The name of the {{lowerResource}}.', required: true, example: 'Example Name')]
final class {{Action}}{{Resource}}Request extends FormRequest
{
    /**
     * Determine if the user is authorized to make this request.
     *
     * @return bool
     */
    public function authorize(): bool
    {
        return true;
    }

    /**
     * Get the validation rules that apply to the request.
     *
     * @return array<string, array<int, string|ValidationRule>>
     */
    public function rules(): array
    {
        $id = $this->route('{{lowerResource}}');

        return [
            'name' => ['required', 'string', 'max:255'],
        ];
    }

    /**
     * Get the request payload.
     *
     * @return {{Action}}{{Resource}}Payload
     */
    public function payload(): {{Action}}{{Resource}}Payload
    {
        return {{Action}}{{Resource}}Payload::fromRequest($this);
    }
}
