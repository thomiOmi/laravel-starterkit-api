<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Actions;

use Modules\{{Module}}\Models\{{Module}};

/**
 * Action for deleting a {{label}}.
 */
final readonly class Delete{{Module}}Action
{
    /**
     * Execute the delete {{label}} action.
     *
     * @param  string  $id  The {{label}} ID.
     * @return bool True if the {{label}} was deleted successfully, false otherwise.
     */
    public function handle(string $id): bool
    {
        ${{lowerResource}} = {{Module}}::query()->find($id);

        if (${{lowerResource}} === null) {
            return false;
        }

        return (bool) ${{lowerResource}}->delete();
    }
}
