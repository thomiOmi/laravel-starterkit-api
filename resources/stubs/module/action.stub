     * @return {{Module}} The updated {{lowerResource}} instance.
     */
    public function handle({{Module}} ${{lowerResource}}, {{Action}}{{Module}}Payload $payload): {{Module}}
    {
        return $this->database->transaction(function () use (${{lowerResource}}, $payload) {
            return $this->repository->update(${{lowerResource}}, $payload->toArray());
        });
    }

    /**
