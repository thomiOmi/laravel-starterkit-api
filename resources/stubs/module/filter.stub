<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Filters;

use App\Filters\BaseFilter;
use Illuminate\Database\Eloquent\Builder;
use Modules\{{Module}}\Models\{{Module}};

/**
 * @extends BaseFilter<{{Module}}>
 */
class {{Module}}Filter extends BaseFilter
{
    /**
     * The list of allowed filters.
     *
     * @var array<int, string>
     */
    protected array $allowedFilters = [
        'search',
    ];

    /**
     * The list of allowed sorts.
     *
     * @var array<int, string>
     */
    protected array $allowedSorts = [
        'created_at',
    ];

    /**
     * Filter by search term.
     *
     * @param  mixed  $value  The search term.
     * @return Builder<{{Module}}>
     */
    public function search(mixed $value): Builder
    {
        /** @var Builder<{{Module}}> $builder */
        $builder = $this->builder;

        if (! is_string($value)) {
            return $builder;
        }

        $value = trim($value);
        $escapedValue = addcslashes($value, '%_');

        return $builder->where('name', 'like', "%{$escapedValue}%");
    }
}
