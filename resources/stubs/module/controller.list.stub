<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Controllers\{{Version}};

use App\Http\Controllers\Controller;
use App\Http\Responses\SuccessResponse;
use Illuminate\Http\Resources\Json\AnonymousResourceCollection;
use Modules\{{Module}}\Models\{{Module}};
use Modules\{{Module}}\Requests\{{Version}}\List{{Module}}Request;
use Modules\{{Module}}\Resources\{{Module}}Resource;

final readonly class ListController extends Controller
{
    /**
     * Display a paginated listing of the {{lowerResource}}s.
     *
     * @return SuccessResponse<AnonymousResourceCollection>
     */
    public function __invoke(List{{Module}}Request $request): SuccessResponse
    {
        ${{lowerResource}}s = {{Module}}::query()
            ->allowedSearch()
            ->allowedFilters()
            ->allowedSorts()
            ->allowedFields()
            ->allowedIncludes()
            ->paginate(
                perPage: $request->getPerPage(),
                page: $request->getPage(),
            );

        return new SuccessResponse(
            data: {{Module}}Resource::collection(${{lowerResource}}s),
            title: 'OK',
            detail: __('general.resource_retrieved', ['resource' => '{{labelPlural}}']),
        );
    }
}
