<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Controllers\{{Version}};

use App\Http\Responses\JsonDataResponse;
use Illuminate\Http\Request;
use Modules\{{Module}}\Models\{{Resource}};
use Modules\{{Module}}\Resources\{{Resource}}Resource;

/**
 * Class IndexController
 *
 * @package Modules\{{Module}}\Controllers\{{Version}}
 */
final readonly class IndexController
{
    /**
     * Handle the incoming request.
     *
     * @param Request $request
     * @return JsonDataResponse
     */
    public function __invoke(Request $request): JsonDataResponse
    {
        $items = {{Resource}}::simplePaginate($request->integer('per_page', 10));

        return new JsonDataResponse(
            data: {{Resource}}Resource::collection($items),
            message: '{{Resource}} list retrieved successfully.',
        );
    }
}
