<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Controllers\{{Version}};

use App\Http\Responses\SuccessResponse;
use Illuminate\Http\Resources\Json\AnonymousResourceCollection;
use Modules\{{Module}}\Actions\List{{pluralModule}}Action;
use Modules\{{Module}}\Filters\{{Module}}Filter;
use Modules\{{Module}}\Resources\{{Module}}Resource;

/**
 * @group {{Module}} Management
 *
 * @authenticated
 */
final readonly class ListController
{
    public function __construct(
        private List{{pluralModule}}Action $list{{pluralModule}}
    ) {}

    /**
     * Display a paginated listing of the {{lowerResource}}s.
     *
     * @return SuccessResponse<AnonymousResourceCollection>
     */
    public function __invoke({{Module}}Filter $filter): SuccessResponse
    {
        ${{lowerResource}}s = $this->list{{pluralModule}}->handle($filter, request()->integer('per_page', 10));

        return new SuccessResponse(
            data: {{Module}}Resource::collection(${{lowerResource}}s),
            title: 'OK',
            detail: __('general.resource_retrieved', ['resource' => '{{Module}}s']),
        );
    }
}
