<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Controllers\{{Version}};

use App\Http\Responses\JsonDataResponse;
use Dedoc\Scramble\Attributes\QueryParameter;
use Illuminate\Http\Request;
use Modules\{{Module}}\Actions\List{{pluralModule}}Action;
use Modules\{{Module}}\Filters\{{Module}}Filter;
use Modules\{{Module}}\Resources\{{Module}}Resource;

/**
 * @group {{Module}} Management
 *
 * @authenticated
 */
final readonly class IndexController
{
    public function __construct(
        private List{{pluralModule}}Action $list{{pluralModule}}
    ) {}

    /**
     * Display a paginated listing of the {{lowerResource}}s.
     */
    #[QueryParameter(name: 'page', description: 'The page number for pagination.', type: 'integer', required: false, default: 1, example: 1)]
    #[QueryParameter(name: 'per_page', description: 'Number of items per page.', type: 'integer', required: false, default: 10, example: 10)]
    #[QueryParameter(name: 'search', description: 'Search keyword to filter {{lowerResource}}s.', type: 'string', required: false, example: 'test')]
    public function __invoke(Request $request, {{Module}}Filter $filter): JsonDataResponse
    {
        ${{lowerResource}}s = $this->list{{pluralModule}}->handle($filter, $request->integer('per_page', 10));

        return new JsonDataResponse(
            data: {{Module}}Resource::collection(${{lowerResource}}s),
            message: __('messages.retrieved', ['resource' => '{{Module}}s'])
        );
    }
}
