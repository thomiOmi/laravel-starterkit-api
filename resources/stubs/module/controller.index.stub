<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Controllers\{{Version}};

use App\Http\Responses\SuccessResponse;
use Dedoc\Scramble\Attributes\QueryParameter;
use Illuminate\Http\Request;
use Modules\{{Module}}\Actions\List{{pluralModule}}Action;
use Modules\{{Module}}\Filters\{{Module}}Filter;
use Modules\{{Module}}\Resources\{{Module}}Resource;
use Symfony\Component\HttpFoundation\Response;

/**
 * @group {{Module}} Management
 *
 * @authenticated
 */
final readonly class IndexController
{
    public function __construct(
        private List{{pluralModule}}Action $list{{pluralModule}}
    ) {}

    /**
     * Display a paginated listing of the {{lowerResource}}s.
     */
    #[QueryParameter(name: 'page[number]', description: 'The page number for pagination.', type: 'integer', required: false, default: 1, example: 1)]
    #[QueryParameter(name: 'page[size]', description: 'Number of items per page.', type: 'integer', required: false, default: 10, example: 10)]
    #[QueryParameter(name: 'search', description: 'Search keyword to filter {{lowerResource}}s.', type: 'string', required: false, example: 'test')]
    public function __invoke(Request $request, {{Module}}Filter $filter): SuccessResponse
    {
        ${{lowerResource}}s = $this->list{{pluralModule}}->handle(
            $filter,
            $request->integer('page.size', 10),
            $request->integer('page.number', 1)
        );

        $resource = {{Module}}Resource::collection(${{lowerResource}}s);

        /** @var array<string, mixed> $raw */
        $raw = $resource->toResponse($request)->getData(true);

        return new SuccessResponse(
            'OK',
            __('general.retrieved', ['resource' => '{{Module}}s']),
            $raw['data'] ?? [],
            Response::HTTP_OK,
            array_filter([
                'meta' => $raw['meta'] ?? null,
                'links' => $raw['links'] ?? null,
            ], fn ($value) => $value !== null),
        );
    }
}
