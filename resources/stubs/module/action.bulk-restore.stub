<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Actions;

use Modules\{{Module}}\Models\{{Module}};

/**
 * Action for bulk restoring {{labelPlural}}.
 */
final readonly class BulkRestore{{pluralModule}}Action
{
    /**
     * Execute the bulk restore {{labelPlural}} action.
     *
     * @param  array<int, string|int>  $ids  The {{label}} IDs to restore.
     * @return int The number of {{labelPlural}} restored.
     */
    public function handle(array $ids): int
    {
        /** @var int $count */
        $count = {{Module}}::onlyTrashed()->whereIn('id', $ids)->restore();

        return $count;
    }
}
