<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Controllers\{{Version}};

use App\Http\Responses\ProblemResponse;
use App\Http\Responses\SuccessResponse;
use Modules\{{Module}}\Actions\Update{{Module}}Action;
use Modules\{{Module}}\Repositories\{{Module}}Repository;
use Modules\{{Module}}\Requests\{{Version}}\Update{{Module}}Request;
use Modules\{{Module}}\Resources\{{Module}}Resource;
use Symfony\Component\HttpFoundation\Response;

/**
 * @group {{Module}} Management
 *
 * @authenticated
 */
final readonly class UpdateController
{
    public function __construct(
        private {{Module}}Repository ${{lowerResource}}Repository,
        private Update{{Module}}Action $update{{Module}},
    ) {}

    /**
     * Update the specified {{lowerResource}} in storage.
     */
    public function __invoke(Update{{Module}}Request $request, string $id): SuccessResponse|ProblemResponse
    {
        ${{lowerResource}} = $this->{{lowerResource}}Repository->findById($id);

        if (! ${{lowerResource}}) {
            return new ProblemResponse(
                title: 'Not Found',
                status: Response::HTTP_NOT_FOUND,
                detail: __('general.not_found', ['resource' => '{{Module}}']),
            );
        }

        ${{lowerResource}} = $this->update{{Module}}->handle(${{lowerResource}}, $request->payload());

        return new SuccessResponse(
            'OK',
            __('general.updated', ['resource' => '{{Module}}']),
            new {{Module}}Resource(${{lowerResource}}),
        );
    }
}
