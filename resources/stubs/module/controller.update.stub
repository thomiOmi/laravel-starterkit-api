    /**
     * Update the specified {{lowerResource}} in storage.
     */
    public function __invoke(Update{{Module}}Request $request, {{Module}} ${{lowerResource}}): JsonResponse
    {
        ${{lowerResource}} = $this->update{{Module}}->handle(${{lowerResource}}, $request->payload());

