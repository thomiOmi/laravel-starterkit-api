<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Controllers\{{Version}};

use App\Http\Responses\JsonDataResponse;
use Modules\{{Module}}\Actions\{{Action}}{{Module}}Action;
use Modules\{{Module}}\Models\{{Module}};
use Modules\{{Module}}\Requests\{{Version}}\{{Action}}{{Module}}Request;
use Modules\{{Module}}\Resources\{{Module}}Resource;
use Symfony\Component\HttpFoundation\Response;

/**
 * @group {{Module}} Management
 *
 * @authenticated
 */
final readonly class {{Action}}Controller
{
    public function __construct(
        private {{Action}}{{Module}}Action $action,
    ) {}

    /**
     * {{Action}} the specified {{lowerResource}}.
     */
    public function __invoke({{Action}}{{Module}}Request $request, ?{{Module}} ${{lowerResource}} = null): JsonDataResponse
    {
        if ($request->isMethod('POST')) {
            ${{lowerResource}} = $this->action->store($request->payload());
            $status = Response::HTTP_CREATED;
            $message = __('messages.created', ['resource' => '{{Module}}']);
        } else {
            /** @var {{Module}} ${{lowerResource}} */
            ${{lowerResource}} = $this->action->handle(${{lowerResource}}, $request->payload());
            $status = Response::HTTP_OK;
            $message = __('messages.updated', ['resource' => '{{Module}}']);
        }

        return new JsonDataResponse(
            data: new {{Module}}Resource(${{lowerResource}}),
            status: $status,
            message: $message
        );
    }
}
