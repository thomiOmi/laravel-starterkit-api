<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Controllers\{{Version}};

use App\Http\Requests\BulkActionRequest;
use App\Http\Responses\SuccessResponse;
use Modules\{{Module}}\Actions\BulkDelete{{pluralModule}}Action;
use Symfony\Component\HttpFoundation\Response;

/**
 * @group {{Module}} Management
 *
 * @authenticated
 */
final readonly class BulkDeleteController
{
    public function __construct(
        private BulkDelete{{pluralModule}}Action $bulkDelete{{pluralModule}},
    ) {}

    /**
     * Perform bulk delete on {{lowerResource}}s.
     */
    public function __invoke(BulkActionRequest $request): SuccessResponse
    {
        /** @var array{ids: array<int, string|int>} $validated */
        $validated = $request->validated();

        $count = $this->bulkDelete{{pluralModule}}->handle($validated['ids']);

        return new SuccessResponse(
            'OK',
            __('general.bulk_action', [
                'resource' => '{{Module}}s',
                'action' => 'delete',
            ]),
            ['count' => $count],
            Response::HTTP_OK,
        );
    }
}
