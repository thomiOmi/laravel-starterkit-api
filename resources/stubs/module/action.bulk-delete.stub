<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Actions;

use Illuminate\Contracts\Auth\Guard;
use Modules\{{Module}}\Models\{{Module}};

/**
 * Action for bulk deleting {{labelPlural}}.
 */
final readonly class BulkDelete{{pluralModule}}Action
{
    public function __construct(
        private Guard $auth,
    ) {}

    /**
     * Execute the bulk delete {{labelPlural}} action.
     *
     * @param  array<int, string|int>  $ids  The {{label}} IDs to delete.
     * @return int The number of {{labelPlural}} deleted.
     */
    public function handle(array $ids): int
    {
        $ids = array_filter($ids, fn (string|int $id): bool => $id !== $this->auth->id());

        if ($ids === []) {
            return 0;
        }

        /** @var int $count */
        $count = {{Module}}::whereIn('id', $ids)->delete();

        return $count;
    }
}
