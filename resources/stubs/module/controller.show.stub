<?php

declare(strict_types=1);

namespace Modules\{{Module}}\Controllers\{{Version}};

use App\Http\Controllers\Controller;
use App\Http\Responses\SuccessResponse;
use Modules\{{Module}}\Actions\Show{{Module}}Action;
use Modules\{{Module}}\Resources\{{Module}}Resource;

final readonly class ShowController extends Controller
{
    public function __construct(
        private Show{{Module}}Action $show{{Module}},
    ) {}

    /**
     * Display the specified {{lowerResource}}.
     *
     * @return SuccessResponse<{{Module}}Resource>
     */
    public function __invoke(string $id): SuccessResponse
    {
        ${{lowerResource}} = $this->show{{Module}}->handle($id);

        return new SuccessResponse(
            data: new {{Module}}Resource(${{lowerResource}}),
            title: 'OK',
            detail: __('general.resource_retrieved', ['resource' => '{{Module}}']),
        );
    }
}
