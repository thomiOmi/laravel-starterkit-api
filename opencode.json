{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "graphify": {
            "type": "local",
            "enabled": true,
            "command": [
                "graphify-mcp",
                "graphify-out/graph.json"
            ]
        }
    }
}
