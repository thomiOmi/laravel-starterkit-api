{
  "pre-commit": {
    "enabled": true,
    "actions": [
      {
        "action": "composer lint:staged"
      }
    ]
  },
  "commit-msg": {
    "enabled": true,
    "actions": [
      {
        "action": "CaptainHook.Message.MustMatchRegex",
        "options": {
          "regex": "#^(feat|fix|build|chore|ci|docs|perf|refactor|revert|style|test)(\\(.+\\))?!?:\\s.{1,}#",
          "error": "Commit message must follow conventional commit format: type(scope?): description"
        }
      }
    ]
  }
}
